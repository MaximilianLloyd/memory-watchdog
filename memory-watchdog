#!/bin/bash
# memory-watchdog: when macOS memory pressure turns critical, kill the largest
# runaway dev-tool process so the system does not run out of swap and start
# killing system helpers (which is what freezes apps).
#
# Runs as a launchd agent (local.memory-watchdog). Log: ~/Library/Logs/memory-watchdog.log
#
# Env overrides (mainly for testing):
#   WATCHDOG_PATTERN  regex of process commands that may be killed
#   WATCHDOG_MIN_MB   minimum memory footprint for a process to be a candidate
#   WATCHDOG_FORCE=1  act as if pressure were critical
#   WATCHDOG_DRY_RUN=1  log the choice but do not kill
#   WATCHDOG_ONCE=1   run a single check and exit

PATTERN="${WATCHDOG_PATTERN:-(^|/| )(tsgolint|tsgo|tsc|tsserver|next-server|esbuild|turbo|vite|vitest|jest|webpack|eslint|node)( |$)|next-server|/node_modules/}"
MIN_MB="${WATCHDOG_MIN_MB:-1500}"
# Chrome tabs (renderer processes only, so the browser itself stays open).
# Lower threshold: Chrome's memory is spread over many tabs rather than one big process.
CHROME_PATTERN="${WATCHDOG_CHROME_PATTERN:-Google Chrome.*Helper \\(.*Renderer\\)}"
CHROME_MIN_MB="${WATCHDOG_CHROME_MIN_MB:-500}"
INTERVAL=3
LOG="$HOME/Library/Logs/memory-watchdog.log"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG"; }

to_mb() { # top MEM field (e.g. 4109M, 12G, 512K, 984M+) -> integer MB
  local v="${1%[+-]}" n u
  n="${v%[KMGB]}"; u="${v: -1}"
  case "$u" in
    G) awk -v n="$n" 'BEGIN{printf "%d", n*1024}' ;;
    M) printf '%d' "${n%.*}" ;;
    *) printf '0' ;;
  esac
}

is_critical() {
  [ "$WATCHDOG_FORCE" = "1" ] && return 0
  local level free
  level=$(sysctl -n kern.memorystatus_vm_pressure_level 2>/dev/null)  # 1 normal, 2 warn, 4 critical
  free=$(sysctl -n kern.memorystatus_level 2>/dev/null)               # % memory available
  [ "$level" = "4" ] && return 0
  [ "$level" = "2" ] && [ "${free:-100}" -le 10 ] && return 0
  return 1
}

pick_victim() { # prints "pid mb command" of the largest matching process, if any
  local pid mem cmd mb uid full
  # top's MEM is the real footprint (includes compressed memory, unlike ps rss)
  top -l 1 -o mem -n 40 -stats pid,mem,command 2>/dev/null | awk 'f{print} /^PID/{f=1}' |
  while read -r pid mem cmd; do
    mb=$(to_mb "$mem")
    [ "$mb" -lt "$CHROME_MIN_MB" ] && [ "$mb" -lt "$MIN_MB" ] && continue
    uid=$(ps -o uid= -p "$pid" 2>/dev/null | tr -d ' ')
    [ "$uid" = "$(id -u)" ] || continue
    full=$(ps -o command= -p "$pid" 2>/dev/null)
    if [ "$mb" -ge "$MIN_MB" ] && echo "$full" | grep -Eq "$PATTERN"; then
      echo "$pid $mb ${full:0:160}"
      break
    fi
    if [ "$mb" -ge "$CHROME_MIN_MB" ] && echo "$full" | grep -Eq "$CHROME_PATTERN"; then
      echo "$pid $mb Chrome tab: $(echo "$full" | sed -E 's/.*(Google Chrome[^/]*Helper \([^)]*\)).*/\1/')"
      break
    fi
  done
}

act() {
  local victim pid mb cmd
  victim=$(pick_victim)
  if [ -z "$victim" ]; then
    log "critical pressure, but no dev process over ${MIN_MB}MB to kill"
    return 1
  fi
  pid="${victim%% *}"; victim="${victim#* }"; mb="${victim%% *}"; cmd="${victim#* }"
  if [ "$WATCHDOG_DRY_RUN" = "1" ]; then
    log "DRY RUN would kill pid=$pid ${mb}MB: $cmd"
    return 0
  fi
  log "critical pressure: killing pid=$pid ${mb}MB: $cmd"
  kill -TERM "$pid" 2>/dev/null
  sleep 3
  kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
  osascript -e "display notification \"Killed ${cmd:0:60} (${mb} MB)\" with title \"Memory watchdog\"" >/dev/null 2>&1 &
  return 0
}

if [ "$WATCHDOG_ONCE" = "1" ]; then
  is_critical && act
  exit 0
fi

log "started (min ${MIN_MB}MB, interval ${INTERVAL}s)"
while true; do
  if is_critical; then
    act
    sleep 5   # let memory settle before deciding to kill another
  else
    sleep "$INTERVAL"
  fi
done
